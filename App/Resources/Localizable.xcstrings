    "Allow Rokuga in System Settings › Privacy & Security › Screen Recording, then relaunch." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定 › プライバシーとセキュリティ › 画面収録でRokugaを許可してから再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 › 개인정보 보호 및 보안 › 화면 기록에서 Rokuga를 허용한 다음 다시 실행하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在系统设置 › 隐私与安全性 › 屏幕录制中允许 Rokuga，然后重新启动。"
          }
        }
      }
    },
